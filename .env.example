# Copia a .env.local y rellena con la config de la app web de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → SDK config).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# true = usar los emuladores locales (npm run emulators) con el proyecto demo-worldmap.
VITE_USE_EMULATORS=true
