rules_version = '2';

// Modelo:
//   users/{uid}                 perfil: displayName, sharing { enabled, token, showNotes }, sharedTrips [ids], tripShares {id: token}
//   users/{uid}/entries/{key}   una entrada por lugar ("country:SLV", "city:3583361", …) con tripIds derivado de sus fechas
//   users/{uid}/notes/{key}     datos privados de la entrada: description, people
//   users/{uid}/trips/{id}      viajes
//   shares/{token}              { uid, displayName, tripId? } — resuelve un link de solo lectura (mapa o viaje)
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function profile(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function sharingEnabled(uid) { return profile(uid).get('sharing', {}).get('enabled', false) == true; }
    function showNotes(uid) { return profile(uid).get('sharing', {}).get('showNotes', false) == true; }
    function sharedTrips(uid) { return profile(uid).get('sharedTrips', []); }
    function inSharedTrip(uid, data) { return data.get('tripIds', []).hasAny(sharedTrips(uid)); }

    match /users/{uid} {
      allow read: if isOwner(uid) || sharingEnabled(uid);
      allow write: if isOwner(uid);

      match /entries/{key} {
        allow read: if isOwner(uid) || sharingEnabled(uid) || inSharedTrip(uid, resource.data);
        allow create, update: if isOwner(uid)
          && request.resource.data.status in ['lived', 'visited', 'transit', 'planned', 'wishlist']
          && request.resource.data.get('tripIds', []) is list
          && request.resource.data.get('tripIds', []).size() <= 100;
        allow delete: if isOwner(uid);
      }

      match /notes/{key} {
        allow read: if isOwner(uid)
          || (showNotes(uid) && (sharingEnabled(uid)
              || inSharedTrip(uid, get(/databases/$(database)/documents/users/$(uid)/entries/$(key)).data)));
        allow create, update: if isOwner(uid)
          && request.resource.data.get('description', '').size() <= 20000
          && request.resource.data.get('people', '').size() <= 500;
        allow delete: if isOwner(uid);
      }

      match /trips/{tripId} {
        allow read: if isOwner(uid) || sharingEnabled(uid) || tripId in sharedTrips(uid);
        allow write: if isOwner(uid);
      }
    }

    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
