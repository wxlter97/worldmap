{
  "functions": {
    "api/og.ts": { "includeFiles": "api/_lib/fonts/**", "maxDuration": 15 },
    "api/share-page.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/s/:token", "destination": "/api/share-page?t=:token" },
    { "source": "/s/:token/:rest*", "destination": "/api/share-page?t=:token" },
    { "source": "/((?!api/|data/|assets/|icons/|sw.js|workbox-).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
